# Copy this file to .env and fill in real values.
# Never commit .env — it is git-ignored.

# ---- Application URLs ----
# MVC UI (ShampanPOSUI) base URL, e.g. https://localhost:44300
BASE_URL=

# Backend Web API (ShampanPOS) base URL, e.g. https://localhost:7242
# Used only for API-based fixture setup/cleanup per the API Setup Rule — never to replace the UI workflow under test.
API_BASE_URL=

# ---- Credentials (never hard-code in test files) ----
# Primary account used for storageState-based authenticated test runs
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secondary/limited account, used for role/menu-restriction and least-privilege negative tests
TEST_USERNAME=
TEST_PASSWORD=

# ---- Execution ----
HEADLESS=true

# Optional: override default timeouts (milliseconds)
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000

# Optional: max number of Playwright workers allowed to be mid-login at the
# same time (STEP 15D/15E worker authentication semaphore, see
# utils/auth-semaphore.ts). Default is 2 if unset.
AUTH_LOGIN_CONCURRENCY=2
